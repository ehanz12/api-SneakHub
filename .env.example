# Salin file ini menjadi .env di server produksi, lalu isi nilainya.

DB_USER = root
DB_PASSWORD = ganti-password
DB_HOST = 127.0.0.1
DB_NAME = sneakhub
DB_PORT = 3306
PORT = "3000"

# URL publik API di server (WAJIB diisi agar callback Midtrans masuk).
# Contoh: https://api-sneakhub.up.railway.app  (tanpa slash di akhir)
PUBLIC_URL =

# Origin frontend (iSneakHub) yang boleh memanggil API. Pisahkan dengan koma
# jika lebih dari satu. Contoh: https://sneakhub.vercel.app,http://localhost:3060
CORS_ORIGINS =

JWT_SECRET = ganti-dengan-random-string-panjang

# Mode payment: "mock" untuk testing tanpa gateway, "tripay", atau "midtrans".
PAYMENT_MODE = midtrans

# Tripay (sandbox: true, production: false).
TRIPAY_API_KEY =""
TRIPAY_PRIVATE_KEY =""
TRIPAY_MERCHANT_CODE =""
TRIPAY_IS_SANDBOX = true

# Midtrans Snap (sandbox: true, production: false). Untuk produksi: false
# dan pakai key dari dashboard.midtrans.com (bukan dashboard.sandbox.midtrans.com).
MIDTRANS_SERVER_KEY =
MIDTRANS_CLIENT_KEY =
MIDTRANS_IS_SANDBOX = true

# Biteship (cek ongkir otomatis). Kosongkan untuk memakai ongkir flat Rp15.000.
BITESHIP_API_KEY =
